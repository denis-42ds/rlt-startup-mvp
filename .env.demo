export RLT_DEMO_BUYER_TOKEN='rlt-local-demo-buyer-token'
export RLT_DEMO_SUPPLIER_TOKEN='rlt-local-demo-supplier-token'
export RLT_DEMO_ORCHESTRATOR_TOKEN='rlt-local-demo-orchestrator-token'

export RLT_DEMO_CREDENTIALS="$(python - <<'PY'
import json
import os

credentials = [
    {
        "token": os.environ["RLT_DEMO_BUYER_TOKEN"],
        "subject_id": "30000000-0000-4000-8000-000000000011",
        "organization_id": "30000000-0000-4000-8000-000000000001",
        "role": "buyer",
    },
    {
        "token": os.environ["RLT_DEMO_SUPPLIER_TOKEN"],
        "subject_id": "10000000-0000-4000-8000-000000000011",
        "organization_id": "10000000-0000-4000-8000-000000000001",
        "role": "supplier",
    },
    {
        "token": os.environ["RLT_DEMO_ORCHESTRATOR_TOKEN"],
        "subject_id": "20000000-0000-4000-8000-000000000011",
        "organization_id": "20000000-0000-4000-8000-000000000001",
        "role": "orchestrator",
    },
]

print(json.dumps(credentials))
PY
)"
